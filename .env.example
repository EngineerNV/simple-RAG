# .env.example
# Copy this file to .env and fill in your own values.
# This file contains example environment variables for your RAG project.

# ==============================================================================
# LLM Provider API Keys (pick ONE - auto-detection will find the first key set)
# ==============================================================================

# OpenAI (checked first; default model: gpt-5-mini)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini (checked second; default model: gemini-2.5-flash)
# Get your key at: https://aistudio.google.com/apikey
# Requires: pip install langchain-google-genai
GOOGLE_API_KEY=

# Anthropic Claude (checked third; default model: claude-sonnet-4-5)
# Get your key at: https://console.anthropic.com/
# Requires: pip install langchain-anthropic
ANTHROPIC_API_KEY=

# ==============================================================================
# Optional: Override detection order with --provider flag
# ==============================================================================
# If you have multiple keys set, the scripts will use the first one found
# (OPENAI > GOOGLE > ANTHROPIC). Use --provider to override:
#   python scripts/02_query.py -q "test" --provider gemini
#
# When --llm-model is not given, each provider uses its own default model
# (see utils/llm.py DEFAULT_MODELS), so a single key is enough to get started.

# ==============================================================================
# Optional: Data Path Configuration
# ==============================================================================
# These are optional - defaults are shown below:

# Directory containing source markdown files for ingestion
CORPUS_DIR=data/corpus

# Chroma vector database storage path
CHROMA_DB_PATH=data/chroma

# ==============================================================================
# Optional: Ingestion/Chunking Configuration
# ==============================================================================
# Tokenizer model for chunk size calculation (default: text-embedding-3-small)
# INGEST_TIKTOKEN_MODEL=text-embedding-3-small

# Chunk size in tokens (default: 400)
# INGEST_CHUNK_SIZE=400

# Chunk overlap in tokens (default: 80)
# INGEST_CHUNK_OVERLAP=80

