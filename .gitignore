# gitignore template for LangChain products, e.g., LangGraph, LangSmith
# website: https://www.langchain.com/
# website: https://www.langchain.com/langgraph

# LangGraph
.langgraph_api/

# Python ignores
__pycache__/
*.py[cod]
*.so
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.mypy_cache/
.pytest_cache/
.tox/
.coverage
coverage.xml
*.cover
.hypothesis/
.pylint.d/
*.log
*.pot
*.mo
*.sqlite3
*.db
*.egg-info/
dist/
build/
*.egg
pip-wheel-metadata/

# Project data artifacts
# Ignore ingested corpus content (keep documentation and the sample corpus)
data/corpus/*
!data/corpus/README.md
!data/corpus/.gitkeep
!data/corpus/Pokémon.MD
# The Chroma index is generated by 01_build_index.py and never committed
data/chroma/
